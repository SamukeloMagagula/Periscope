    "install-shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File assets/install-shortcut.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "periscope": "dist/index.js"
  }
}
