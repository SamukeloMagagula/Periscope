{
  "name": "periscope",
  "version": "0.1.0",
  "description": "Give Claude/Copilot eyes (screenshots) and hands (mouse/keyboard/window control) on your Windows laptop via MCP",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/index.js",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File assets/launcher.ps1",
